\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-C}}Gumbel-Softmax Routing Experiments}{3}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Variant R1 (state-dependent router): training/validation curves and routing summary. The router commits to $\operatorname  {identity}(v)$ for $\dot  {x}$ and $\operatorname  {identity}(x)$ for $\dot  {v}$, but $k{=}1$ selection precludes recovery of the damping component, leaving val MSE at $\approx 7.2\times 10^{-4}$.}}{4}{}\protected@file@percent }
\newlabel{fig:r1}{{5}{4}{}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Variant R2 (state-independent router): the router converges to $\sin $ rather than $\operatorname  {identity}$, illustrating the $\sin (z) \approx z$ collinearity at small $|z|$ that motivates the complexity prior in R3. Validation MSE plateaus at $\approx 1.2\times 10^{-3}$, dominated by the missing damping term.}}{4}{}\protected@file@percent }
\newlabel{fig:r2}{{6}{4}{}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Variant R3 with stochastic Gumbel-Softmax sampling at validation time. The validation curve shows order-of-magnitude excursions at individual logging epochs (e.g., epoch $1{,}600$ reading $1.9\times 10^{-3}$ between $10^{-6}$ neighbours) caused by single unlucky Gumbel draws.}}{4}{}\protected@file@percent }
\newlabel{fig:r3_orig}{{7}{4}{}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Variant R4 with stochastic Gumbel-Softmax sampling at validation time. Three spikes appear at epochs $1{,}400$, $1{,}600$, and $2{,}800$, each roughly $10^{5}\times $ the surrounding floor and recovering within one logging interval.}}{4}{}\protected@file@percent }
\newlabel{fig:r4_orig}{{8}{4}{}{figure.8}{}}
